{
  "name": "driveflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Premium SaaS web app to upload files directly to Google Drive, with AI-powered journaling via Gemini.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "start:server": "node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:security": "tsx --test tests/backend-security.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "@hookform/resolvers": "^3.9.1",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "firebase": "^11.0.2",
    "firebase-admin": "^12.6.0",
    "framer-motion": "^12.0.0",
    "helmet": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
