# Firebase (Frontend - Vite)
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Google OAuth Web client ID (frontend) — enables the reliable GIS connect flow.
# IMPORTANT: Setup required - see GOOGLE_CONSOLE_SETUP.md for detailed instructions
# Create it in Google Cloud Console: APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized JS origins / redirect URIs must include http://localhost:3000.
# Same client ID as GOOGLE_CLIENT_ID below.
VITE_GOOGLE_CLIENT_ID=

# Backend API base URL (used by the optional frontend AI service)
VITE_API_BASE_URL=http://localhost:3001

# Firebase Admin SDK (Backend - Server-side only)
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR_PROJECT_ID.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# Google Cloud Secret Manager
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GEMINI_SECRET_NAME=gemini-api-key

# Development-only Gemini fallback (DO NOT use in production)
# DEV_gemini-api-key=YOUR_GEMINI_API_KEY

# Backend Server
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# n8n Drive automation (optional; only used behind backend auth)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Google OAuth web client (REQUIRED for cross-device Drive token refresh).
# These are the credentials for the OAuth 2.0 Client (type "Web application") that
# grants the drive.file scope. They let backend exchanges stored refresh tokens for
# fresh access tokens so a Drive connection persists across devices. See the OAuth
# consent screen in Google Cloud Console.
# GOOGLE_CLIENT_SECRET is a long-lived secret; store it in Google Cloud Secret
# Manager in production, never in the frontend bundle or commit it to git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth redirect URI registered in the Google Cloud OAuth client (type "Web
# application"). This is the backend callback that exchanges the authorization
# code for tokens. Must exactly match a registered redirect URI. Defaults to the
# local backend:
#   http://localhost:3001/api/drive/oauth/callback
# In production, set this to https://<your-backend>/api/drive/oauth/callback and
# register it in the console.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/drive/oauth/callback

# Secret used to HMAC-sign the OAuth `state` parameter so a forged state cannot
# write tokens into another user's record. Set a long random value in production.
# If unset, a fixed dev default is used.
OAUTH_STATE_SECRET=

# Drive Activity API (optional but recommended):
# Make sure the "Google Drive API" is enabled and the OAuth consent screen
# includes the drive.activity.readonly scope. The scope is added to the frontend
# constants so the user's consent includes it, enabling the /api/drive/activity
# endpoint. If not granted, that endpoint will return a clear error.

# Firestore: the server-only `driveTokensServer` collection stores OAuth refresh
# tokens. Firestore rules deny frontend access to that collection (see
# firestore.rules). The legacy `driveTokens` collection only holds non-sensitive
# token metadata and a short-lived access token. No additional configuration is
# required — deploy the updated firestore.rules.

# Note: uploads go directly to each user's own Google Drive (drive.file scope),
# so no n8n webhook env vars are needed for file uploads. The n8n webhook is only
# used for the server-side journal export automation and is never called by the browser.
